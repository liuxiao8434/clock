import tkinter as tk
from datetime import datetime


# Windows 会把这个颜色完全抠除，因此不要把它用作文字颜色
TRANSPARENT_COLOR = "#FF00FF"

TEXT_COLOR = "#FFD84D"
DATE_COLOR = "#E8C96A"
MUTED_COLOR = "#C9A93A"
ACCENT_COLOR = "#FFD84D"


class DesktopClock:
    def __init__(self, root):
        self.root = root
        self.root.title("桌面时钟")
        self.root.overrideredirect(True)  # 无边框
        self.root.attributes("-topmost", True)
        self.root.configure(bg=TRANSPARENT_COLOR)

        # Windows：让指定的洋红色背景完全透明
        self.root.attributes("-transparentcolor", TRANSPARENT_COLOR)

        # 放在屏幕右上角
        self.root.update_idletasks()
        x = max(0, self.root.winfo_screenwidth() - 300)
        self.root.geometry(f"270x115+{x}+36")

        # 所有容器背景都必须使用透明键色
        self.card = tk.Frame(
            root,
            bg=TRANSPARENT_COLOR,
            padx=12,
            pady=8,
        )
        self.card.pack(fill="both", expand=True)

        header = tk.Frame(self.card, bg=TRANSPARENT_COLOR)
        header.pack(fill="x")

        self.dot = tk.Label(
            header,
            text="●",
            font=("Segoe UI", 9),
            fg=ACCENT_COLOR,
            bg=TRANSPARENT_COLOR,
        )
        self.dot.pack(side="left")

        self.title_label = tk.Label(
            header,
            text="  LOCAL TIME",
            font=("Segoe UI", 9, "bold"),
            fg=MUTED_COLOR,
            bg=TRANSPARENT_COLOR,
        )
        self.title_label.pack(side="left")

        self.time_label = tk.Label(
            self.card,
            text="00:00:00",
            font=("Segoe UI Light", 38),
            fg=TEXT_COLOR,
            bg=TRANSPARENT_COLOR,
            anchor="w",
        )
        self.time_label.pack(fill="x", pady=(2, 0))

        self.date_label = tk.Label(
            self.card,
            text="",
            font=("Microsoft YaHei UI", 10),
            fg=DATE_COLOR,
            bg=TRANSPARENT_COLOR,
            anchor="w",
        )
        self.date_label.pack(fill="x", pady=(0, 4))

        # 右键菜单
        self.topmost_var = tk.BooleanVar(value=True)
        self.menu = tk.Menu(root, tearoff=False)
        self.menu.add_checkbutton(
            label="窗口置顶",
            variable=self.topmost_var,
            command=self.toggle_topmost,
        )
        self.menu.add_separator()
        self.menu.add_command(label="退出", command=self.root.destroy)

        # 在窗口和可见文字上都支持右键菜单及拖动
        widgets = (
            self.root,
            self.card,
            header,
            self.dot,
            self.title_label,
            self.time_label,
            self.date_label,
        )

        for widget in widgets:
            widget.bind("<ButtonPress-1>", self.start_drag)
            widget.bind("<B1-Motion>", self.drag)
            widget.bind("<Button-3>", self.show_menu)

        self.root.bind("<Escape>", lambda event: self.root.destroy())

        self.update_clock()

    def update_clock(self):
        now = datetime.now()
        weekdays = [
            "星期一", "星期二", "星期三", "星期四",
            "星期五", "星期六", "星期日",
        ]

        self.time_label.config(text=now.strftime("%H:%M:%S"))
        self.date_label.config(
            text=f"{now:%Y年%m月%d日}  {weekdays[now.weekday()]}"
        )

        self.root.after(250, self.update_clock)

    def start_drag(self, event):
        self.drag_x = event.x_root - self.root.winfo_x()
        self.drag_y = event.y_root - self.root.winfo_y()

    def drag(self, event):
        x = event.x_root - self.drag_x
        y = event.y_root - self.drag_y
        self.root.geometry(f"+{x}+{y}")

    def show_menu(self, event):
        try:
            self.menu.tk_popup(event.x_root, event.y_root)
        finally:
            self.menu.grab_release()
        return "break"

    def toggle_topmost(self):
        self.root.attributes("-topmost", self.topmost_var.get())


if __name__ == "__main__":
    root = tk.Tk()

    try:
        app = DesktopClock(root)
        root.mainloop()
    except tk.TclError as error:
        print("创建透明窗口失败：", error)
        print("请确认是在 Windows 上运行，并且使用支持 Tkinter 的 Python。")
